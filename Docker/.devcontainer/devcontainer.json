{
  "name": "PX4 SITL Dev Container",

  // Reuses the same image/build as the normal run setup, plus an override
  // that stops it from auto-launching the sim on start.
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.extend.yml"
  ],
  "service": "px4-sitl",
  "workspaceFolder": "/PX4-Autopilot",

  // Keeps the container running after VS Code disconnects, so you don't
  // lose your dev container between sessions.
  "shutdownAction": "none",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-python.python",
        "ms-iot.vscode-ros",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "cmake.configureOnOpen": false
      }
    }
  },

  // Runs once after the container is created — makes sure the source is
  // present (in case this is a brand new volume) without launching Gazebo.
  "postCreateCommand": "test -f /PX4-Autopilot/Makefile || git clone --recurse-submodules https://github.com/PX4/PX4-Autopilot.git /PX4-Autopilot",

  "remoteUser": "root"
}
